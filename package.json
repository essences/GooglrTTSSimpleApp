{
  "name": "googlrttssimpleapp",
  "version": "1.0.0",
  "description": "研修ナレーションスタジオ - Gemini TTS を使った音声生成アプリ",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "npx http-server src -p 8080 -c-1 -o",
    "server": "node server/pro-tts-server.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test regression-smoke",
    "test:api-key": "playwright test api-key-management",
    "test:unit": "node tests/ui/history-view.unit.js && node tests/ui/section-preview.unit.js && node tests/services/generation-controller.unit.js && node tests/services/storage-service.unit.js && node tests/services/history-service.unit.js",
    "test:report": "playwright show-report"
  },
  "keywords": ["tts", "gemini", "audio", "narration"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "jsdom": "^24.1.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.11.0",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  }
}
